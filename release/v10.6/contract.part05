turn; }
  $('status').textContent = 'Lendo anexos...';
  const compImgs = await renderPdfFile($('comprovante').files[0], 99, true);
  const voucherImgs = await renderPdfFile($('voucher').files[0], 99, false);
  $('status').textContent = 'Gerando PDF...';
  const {jsPDF} = window.jspdf;
  const pdf = new jsPDF({orientation:'portrait',unit:'pt',format:'a4',compress:true});
  pdf.setProperties({title:`Contrato - ${d.nome}`, subject:'Contrato de prestação de serviços', author:'Indômito Tours'});
  addContractPage1(pdf,d); addContractPage2(pdf,d); addContractPage3(pdf,d); addContractPage4(pdf,d); addContractPage5(pdf,d); addAttachments(pdf,compImgs,voucherImgs);
  pdf.save(`Contrato - ${safeName(d.nome)}.pdf`);
  $('status').textContent = 'Contrato gerado.';
}




function setStatus(msg){ const el=document.getElementById('status'); if(el) el.textContent=msg; }
window.addEventListener('error', (e)=>{ setStatus('Erro: ' + (e.message || 'falha desconhecida')); });
window.addEventListener('unhandledrejection', (e)=>{ setStatus('Erro: ' + (e.reason && e.reason.message ? e.reason.message : e.reason)); });
async function gerarPDFSeguro(){
  try {
    if(!window.jspdf || !window.jspdf.jsPDF){
      setStatus('Erro: biblioteca jsPDF não carregou. Verifique a internet ou use Chrome/Edge.');
      alert('A biblioteca jsPDF não carregou. Esta versão usa bibliotecas online. Verifique a internet e abra no Chrome/Edge.');
      return;
    }
    if(!window.pdfjsLib){
      setStatus('Erro: biblioteca PDF.js não carregou. Verifique a internet ou use Chrome/Edge.');
      alert('A biblioteca PDF.js não carregou. Esta versão usa bibliotecas online. Verifique a internet e abra no Chrome/Edge.');
      return;
    }
    if(window.pdfjsLib && pdfjsLib.GlobalWorkerOptions){
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
    await gerarPDF();
  } catch (err) {
    console.error(err);
    setStatus('Erro ao gerar: ' + (err && err.message ? err.message : err));
    alert('Erro ao gerar PDF: ' + (err && err.message ? err.message : err));
  }
}
window.addEventListener('DOMContentLoaded',()=>{
  const btn=document.getElementById('gerar');
  const limpar=document.getElementById('limpar');
  if(btn) btn.addEventListener('click', gerarPDFSeguro);
  if(limpar) limpar.addEventListener('click',()=>{ document.querySelectorAll('input,textarea').forEach(e=>{ if(e.type==='file') e.value=''; else e.value=''; }); setStatus('Formulário limpo.'); });
});


